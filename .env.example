# --- JARVIS (Sprach-Assistent) ---------------------------------------------
# Nur für lokale Entwicklung. Kopiere diese Datei zu ".env" und trag deinen
# Anthropic-Key ein. Wird NUR serverseitig gelesen (Vite-Dev-Proxy) und landet
# nie im Frontend-Bundle. Danach den Dev-Server neu starten.
#
# Beim Hosting auf Vercel wird der Key stattdessen dort unter
# Environment Variables gesetzt — nicht in dieser Datei.
ANTHROPIC_API_KEY=

# Zugangscode für die öffentlich erreichbare Chat-Schnittstelle. Wird auf Vercel
# gesetzt, nicht hier. Ohne ihn kann jeder, der die Adresse kennt, auf deine
# Kosten Anfragen stellen.
APP_ACCESS_CODE=

# Optional: eigener Chat-Proxy (z.B. Supabase Edge Function). Bleibt das leer,
# nutzt die App automatisch /api/chat — lokal den Vite-Proxy, deployed die
# Serverless Function unter api/chat.ts.
VITE_CHAT_PROXY_URL=

# Filled in during Phase 0 when the local data layer (db.ts) is swapped
# for a Supabase-backed one.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
