# URL of the chat proxy that forwards requests to the Anthropic API
# (e.g. a deployed Supabase Edge Function, see supabase/functions/chat).
# Leave unset to run the app fully offline without the JARVIS chat feature.
VITE_CHAT_PROXY_URL=

# Filled in during Phase 0 when the local data layer (db.ts) is swapped
# for a Supabase-backed one.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
