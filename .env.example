# --- JARVIS (Sprach-Assistent) ---------------------------------------------
# Kopiere diese Datei zu ".env" und trag deinen Anthropic-Key ein.
# Wird NUR serverseitig gelesen (Vite-Dev-Proxy) und landet nie im Frontend-Bundle.
# Danach den Dev-Server neu starten — JARVIS läuft dann lokal per `npm run dev`.
ANTHROPIC_API_KEY=

# Nur für Produktions-Builds nötig (Handy/PWA): URL der deployten Supabase
# Edge Function. Im Dev-Modus wird automatisch der lokale Proxy /api/chat genutzt.
VITE_CHAT_PROXY_URL=

# Filled in during Phase 0 when the local data layer (db.ts) is swapped
# for a Supabase-backed one.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
