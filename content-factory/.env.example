# Copy to apps/api/.env and apps/worker/.env (both read the same values)

DATABASE_URL=postgresql://content_factory:content_factory@localhost:5432/content_factory
REDIS_URL=redis://localhost:6379

# Where your clips and finished videos live. The API and worker must point at
# the same place — the default resolves to content-factory/storage for both,
# since each runs from its own apps/<name> folder. Point it at an absolute
# path (an external drive, say) to keep the videos elsewhere.
STORAGE_ROOT=../../storage

JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# apps/web/.env
VITE_API_PROXY_TARGET=http://localhost:4000
