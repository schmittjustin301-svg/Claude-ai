# Copy to apps/api/.env and apps/worker/.env (both read the same values)

DATABASE_URL=postgresql://content_factory:content_factory@localhost:5432/content_factory
REDIS_URL=redis://localhost:6379

# Where uploaded/rendered files live on disk. Must be the SAME absolute path
# for both the API and worker processes (they share the filesystem).
STORAGE_ROOT=../../storage

JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# apps/web/.env
VITE_API_PROXY_TARGET=http://localhost:4000
